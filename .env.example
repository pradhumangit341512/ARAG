# ============================================================
#   Agentic RAG - Environment Variables
#   Copy this file to .env and fill in your keys
# ============================================================

# ---- Groq (Required for LLM reasoning) ----
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=gsk-your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile

# ---- Neo4j Graph Database ----
# Option 1: Use Neo4j AuraDB (Free Cloud) → https://neo4j.com/cloud/platform/aura-graph-database/
# Option 2: Run locally with Docker → docker run -p 7474:7474 -p 7687:7687 neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ---- Serper API (Free 2500 searches/month) → https://serper.dev ----
SERPER_API_KEY=your-serper-api-key-here
